funcao vazio principal()
inicio
    inteiro contador;
    inteiro i;

    contador = 0;
    enquanto contador < 3 faca
        imprima(contador);
        contador = contador + 1;
    fim_enquanto

    faca
        imprima(contador);
        contador = contador - 1;
    fim_faca enquanto contador > 0 ;

    para i = 1 ate 3 faca
        imprima(i);
    fim_para
fim
